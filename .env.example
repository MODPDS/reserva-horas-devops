# ------------------------------------------------------------
# Plantilla de variables de entorno (valores de EJEMPLO).
# Copiar a .env y ajustar:   cp .env.example .env
# El archivo .env está excluido en .gitignore y NUNCA debe publicarse.
# ------------------------------------------------------------

# Puerto local donde se publica el servicio (http://localhost:8080)
APP_PORT=8080

# Nombre del contenedor
CONTAINER_NAME=reserva-horas-web

# Versión de la imagen (etiqueta reserva-horas:<versión>)
APP_VERSION=1.0.0

# Entorno de ejecución: local | pruebas | produccion
APP_ENV=local

# Ejemplo de variable sensible: en un entorno real se gestionaría con un
# gestor de secretos o GitHub Secrets, nunca en el repositorio.
# Este servicio estático no la utiliza.
API_KEY_EJEMPLO=reemplazar-por-valor-real-solo-en-.env
